ex:CapabilityGap_IncidentDetection a owl:NamedIndividual,
        cw:CapabilityGapAssessment ;
    prov:wasDerivedFrom ex:EvidenceGap_R4_DetectionRuleTuning,
        ex:MaturityGap_IncidentDetection,
        ex:ProficiencyGap_R1_LogCorrelation,
        ex:ProficiencyGap_R3_IncidentReporting ;
    cw:combinedGapScore 0.3875 ;
    cw:comparedMaturity ex:MA_IncidentDetection ;
    cw:gapCapability ex:IncidentDetection ;
    cw:gapPriority 0.34875 ;
    cw:gapStatus cw:Open ;
    cw:inSnapshot ex:Snapshot2026Q4 ;
    cw:maturityEvidenceCoverage 0.8 ;
    cw:maturityGapScore 0.375 ;
    cw:methodVersion "CARISMA-WorkKG scoring procedure v0.3" ;
    cw:priorityDetermined true ;
    cw:proficiencyEvidenceCoverage 0.83333 ;
    cw:proficiencyGapScore 0.4 .

ex:Coverage_R2_IncidentTriage a owl:NamedIndividual,
        cw:RequirementCoverage ;
