    cw:profileCompetency ex:DetectionRuleTuning,
        ex:IncidentReporting,
        ex:IncidentTriage,
        ex:LogCorrelation ;
    cw:profileTask ex:Monitoring,
        ex:TriageTask .

ex:P2 a owl:NamedIndividual,
        cw:ProficiencyLevel ;
    rdfs:label "P2 - intermediate" ;
    cw:levelScale ex:LocalProficiencyScale ;
    cw:ordinalRank "2"^^xsd:nonNegativeInteger .

ex:AnalystA a owl:NamedIndividual,
        cw:Employee ;
    rdfs:label "Analyst A" .

ex:P3 a owl:NamedIndividual,
        cw:ProficiencyLevel ;
    rdfs:label "P3 - proficient" ;
    cw:levelScale ex:LocalProficiencyScale ;
    cw:ordinalRank "3"^^xsd:nonNegativeInteger .

ex:PracticalExercise2026 a owl:NamedIndividual,
        cw:Evidence ;
    rdfs:label "Practical SOC exercise, September 2026 (synthetic)" .

ex:Snapshot2026Q4 a owl:NamedIndividual,
        cw:AssessmentSnapshot ;
    rdfs:label "Assessment snapshot 2026-10-04" ;
    cw:alpha 0.5 ;
    cw:assessedAt "2026-10-04T09:00:00+00:00"^^xsd:dateTime ;
    cw:evidenceMaxAgeDays "365"^^xsd:nonNegativeInteger ;
    cw:methodVersion "CARISMA-WorkKG scoring procedure v0.2" ;
    cw:minMaturityEvidenceCoverage 0.8 ;
    cw:minProficiencyEvidenceCoverage 0.8 ;
    cw:scopeDescription "All SOC staff assigned to incident detection are included in the inventory. Parameters are illustrative study assumptions, not recommended defaults." ;
    cw:snapshotUnit ex:SOC ;
    cw:workforceInventoryComplete true .

ex:IncidentDetection a owl:NamedIndividual,
        cw:OrganizationalCapability ;
    rdfs:label "Incident detection" ;
    cw:capabilityCriticality 0.90 ;
    cw:capabilityUnit ex:SOC ;
    cw:hasEvidence ex:CriticalityRationale ;
    cw:hasRequirement ex:R1_LogCorrelation,
        ex:R2_IncidentTriage,
        ex:R3_IncidentReporting,
        ex:R4_DetectionRuleTuning ;
    cw:performsTaskType ex:LogCorrelationTask,
        ex:Monitoring,
        ex:TriageTask ;
    cw:supportsAsset ex:ProductionSIEM ;
    cw:targetMaturity cw:ML3 .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ex:AnalystA ex:AnalystB ex:AnalystC ) .

