<https://ict.ihu.gr/carisma-workkg/scenario/incident-detection> a owl:Ontology ;
    rdfs:label "CARISMA-WorkKG illustrative incident-detection scenario" ;
    dcterms:creator "Adam P. Filippidis" ;
    rdfs:comment "Hypothetical data reproducing Section 4 / Table 3 of the paper. Values are illustrative, not empirically calibrated." ;
    owl:imports <https://ict.ihu.gr/carisma-workkg> ;
    owl:versionInfo "0.2.0" .

ex:A1_LogCorrelationTraining a owl:NamedIndividual,
        cw:TrainingAction ;
    rdfs:label "Log-correlation upskilling (Analysts B, C)" ;
    cw:addressesGap ex:ProficiencyGap_R1_LogCorrelation ;
    cw:currency "EUR" ;
    cw:durationDays "45"^^xsd:nonNegativeInteger ;
    cw:estimatedCost 3000.0 .

ex:A2_ReportingTraining a owl:NamedIndividual,
        cw:TrainingAction ;
    rdfs:label "Incident-reporting training" ;
    cw:addressesGap ex:ProficiencyGap_R3_IncidentReporting ;
    cw:currency "EUR" ;
    cw:durationDays "20"^^xsd:nonNegativeInteger ;
    cw:estimatedCost 1500.0 ;
    cw:requiresAction ex:A4_EscalationProcedure .

ex:A3_TuningReassessment a owl:NamedIndividual,
        cw:ReassessmentAction ;
    rdfs:label "Re-assess detection-rule tuning competence" ;
    cw:addressesGap ex:EvidenceGap_R4_DetectionRuleTuning ;
    cw:currency "EUR" ;
    cw:durationDays "10"^^xsd:nonNegativeInteger ;
    cw:estimatedCost 500.0 .

ex:AssignA a owl:NamedIndividual,
        cw:RoleAssignment ;
    cw:allocationFraction 1.0 ;
    cw:assignedEmployee ex:AnalystA ;
    cw:assignedProfile ex:CyberIncidentResponder ;
    cw:assignmentUnit ex:SOC ;
    cw:validFrom "2024-01-01T00:00:00+00:00"^^xsd:dateTime .

ex:AssignB a owl:NamedIndividual,
