  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#criterionDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>criterionDimension</rdfs:label>
    <rdfs:comment>One of the five rubric dimensions: responsibility and resourcing, process definition, workforce development and continuity, performance measurement, continuous improvement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityCriterion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#capabilityUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>capabilityUnit</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#levelScale">
