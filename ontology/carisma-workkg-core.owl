    <rdfs:label>methodVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#assetRequiresCompetency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assetRequiresCompetency</rdfs:label>
    <rdfs:comment>Inferred via the property chain inverse(supportsAsset) o hasRequirement o requiredCompetency.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#Asset"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyConcept"/>
    <owl:propertyChainAxiom rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb80"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#MaturityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb54"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb55"/>
    <rdfs:label>MaturityAssessment</rdfs:label>
    <rdfs:comment>Assessment result for practices supporting one organizational capability, under a named maturity model, recorded criterion by criterion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#capabilityCriticality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>capabilityCriticality</rdfs:label>
    <rdfs:comment>Operational importance of the capability on a 0..1 scale, justified by linked risk scenarios and evidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb16">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#Covered"/>
    <rdf:rest rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb17"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#qualifiedCount">
