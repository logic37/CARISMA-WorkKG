  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb61">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#RequirementCoverage"/>
    <rdf:rest rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb62"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Technology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>Technology</rdfs:label>
    <rdfs:comment>A technology type or product vocabulary item.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#weight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>weight</rdfs:label>
    <rdfs:comment>Importance of the requirement to the capability's tasks, set by documented expert judgment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ML3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
    <rdfs:label>3 - Defined</rdfs:label>
    <cw:levelModel rdf:resource="https://ict.ihu.gr/carisma-workkg#CarismaMaturityRubric"/>
    <cw:ordinalRank rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</cw:ordinalRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ML2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
    <rdfs:label>2 - Managed</rdfs:label>
    <cw:levelModel rdf:resource="https://ict.ihu.gr/carisma-workkg#CarismaMaturityRubric"/>
    <cw:ordinalRank rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</cw:ordinalRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://ict.ihu.gr/carisma-workkg/0.3.0"/>
    <owl:priorVersion rdf:resource="https://ict.ihu.gr/carisma-workkg/0.2.0"/>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <rdfs:label>CARISMA-WorkKG core ontology</rdfs:label>
    <rdfs:comment>Core OWL 2 ontology connecting cybersecurity capability requirements, contextual employee competence assessments, organizational maturity assessments, evidence, typed gaps and candidate investment actions. Organization-specific data (e.g. the incident-detection scenario) is kept in separate files that import this ontology.</rdfs:comment>
    <dcterms:creator>Adam P. Filippidis</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-25</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Covered">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#CoverageStatus"/>
    <rdfs:label>covered</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#requirementSourceProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>requirementSourceProfile</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyRequirement"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#RoleProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ProficiencyGap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ict.ihu.gr/carisma-workkg#GapAssessment"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb69"/>
    <rdfs:label>ProficiencyGap</rdfs:label>
    <rdfs:comment>A demonstrated shortfall relative to a competency requirement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb42">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://ict.ihu.gr/carisma-workkg#resultCriterion"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityCriterion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#requiredLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>requiredLevel</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyRequirement"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#ProficiencyLevel"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://ict.ihu.gr/carisma-workkg#assessedEmployee"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://ict.ihu.gr/carisma-workkg#Employee"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#workforceInventoryComplete">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>workforceInventoryComplete</rdfs:label>
    <rdfs:comment>If false, no requirement may be classified as deficient (absence of qualified staff cannot be concluded).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#AssessmentSnapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#observedMaturity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>observedMaturity</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityAssessment"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#AssessmentSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>AssessmentSnapshot</rdfs:label>
    <rdfs:comment>A dated analytical scope that also carries the scoring parameters (alpha, evidence-coverage thresholds, maximum evidence age) and an explicit workforce-inventory completeness statement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb9">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#Closed"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb38">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#CoverageStatus"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb4">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#Accepted"/>
    <rdf:rest rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb31">
    <rdf:first rdf:resource="https://ict.ihu.gr/carisma-workkg#Covered"/>
    <rdf:rest rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb32"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#coverageDeficiency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>coverageDeficiency</rdfs:label>
    <rdfs:comment>max(0, 1 - qualified/required); absent when the coverage status is unresolved.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#RequirementCoverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#supportsAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>supportsAsset</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#Asset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ECompetence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyConcept"/>
    <rdfs:label>ECompetence</rdfs:label>
    <rdfs:comment>An e-CF competence concept; source framework and level must be preserved.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#InvestmentAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb78"/>
    <rdfs:label>InvestmentAction</rdfs:label>
    <rdfs:comment>A candidate intervention linked to the gaps it is intended to address; its effects remain estimates until evaluated.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#assessedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>assessedAt</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#assignmentUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assignmentUnit</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#RoleAssignment"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#evidenceMaxAgeDays">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>evidenceMaxAgeDays</rdfs:label>
    <rdfs:comment>Competency assessments older than this at the snapshot date are outdated and not accepted for coverage.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#AssessmentSnapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#maturityCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>maturityCapability</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityAssessment"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ProcessImprovementAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ict.ihu.gr/carisma-workkg#InvestmentAction"/>
    <rdfs:label>ProcessImprovementAction</rdfs:label>
    <rdfs:comment>An intervention in organizational practices.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Closed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#GapStatus"/>
    <rdfs:label>closed</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#targetMaturity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>targetMaturity</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#hasCriterionResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label>hasCriterionResult</rdfs:label>
    <rdfs:comment>Links a maturity assessment to its per-criterion results; each result belongs to one assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityAssessment"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#CriterionResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#RoleAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb44"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb45"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb46"/>
    <rdfs:label>RoleAssignment</rdfs:label>
    <rdfs:comment>A contextual assignment of a person to a reference role, with dates and allocation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#hasRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasRequirement</rdfs:label>
    <owl:inverseOf rdf:resource="https://ict.ihu.gr/carisma-workkg#requirementCapability"/>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#OrganizationalCapability"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyRequirement"/>
  </rdf:Description>
