    <rdfs:label>CompetencyRequirement</rdfs:label>
    <rdfs:comment>An approved local demand for one competence at a proficiency threshold in one capability context.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
