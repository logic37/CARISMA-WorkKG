  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ML1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
