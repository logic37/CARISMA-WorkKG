    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>RoleProfile</rdfs:label>
    <rdfs:comment>A reference role profile. ECSF role names are individuals of this class.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb60">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://ict.ihu.gr/carisma-workkg#coverageStatus"/>
    <owl:hasValue rdf:resource="https://ict.ihu.gr/carisma-workkg#Deficient"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb53">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://ict.ihu.gr/carisma-workkg#observedLevel"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://ict.ihu.gr/carisma-workkg#ProficiencyLevel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#methodVersion">
