  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Evidence</rdfs:label>
    <rdfs:comment>Source document, assessment record or observation supporting a claim.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#CriterionResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb42"/>
    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb43"/>
    <rdfs:label>CriterionResult</rdfs:label>
    <rdfs:comment>The recorded result (met, partly met, not met, not assessed) of one criterion within one maturity assessment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#NotMet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#CriterionStatus"/>
    <rdfs:label>not met</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#TrainingAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ict.ihu.gr/carisma-workkg#InvestmentAction"/>
    <rdfs:label>TrainingAction</rdfs:label>
    <rdfs:comment>A proposed learning intervention.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#requiresAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>requiresAction</rdfs:label>
    <rdfs:comment>Prerequisite: the subject action can start only after the object action.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#InvestmentAction"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#InvestmentAction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#RoleProfile">
