    <rdfs:label>levelScale</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#ProficiencyLevel"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#ProficiencyScale"/>
