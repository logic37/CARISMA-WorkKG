  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#combinedGapScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>combinedGapScore</rdfs:label>
    <rdfs:comment>Withheld (absent) when either evidence coverage is below its snapshot threshold.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#CapabilityGapAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#UnresolvedCoverage">
