    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyRequirement"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#DeliverableType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>DeliverableType</rdfs:label>
    <rdfs:comment>A type of expected work product.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#profileCompetency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>profileCompetency</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#RoleProfile"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#CompetencyConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Asset</rdfs:label>
    <rdfs:comment>A concrete organizational asset or deployment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#estimatedCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>estimatedCost</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#InvestmentAction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#CapabilityGapAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ict.ihu.gr/carisma-workkg#GapAssessment"/>
    <rdfs:label>CapabilityGapAssessment</rdfs:label>
    <rdfs:comment>Capability-level scoring result within a snapshot: proficiency and maturity gap scores, their evidence coverage, the combined gap score and the gap priority.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#PartlyMet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#CriterionStatus"/>
    <rdfs:label>partly met</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#DeficientCoverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DeficientCoverage</rdfs:label>
    <rdfs:comment>Inferred: a coverage result with a demonstrated headcount shortfall.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb59"/>
  </rdf:Description>
