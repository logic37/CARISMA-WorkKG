    <rdfs:label>CompetencyConcept</rdfs:label>
    <rdfs:comment>Reusable competence vocabulary item, not an employee competence assertion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#affectsAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>affectsAsset</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#RiskScenario"/>
