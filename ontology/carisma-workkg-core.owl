    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>alpha</rdfs:label>
    <rdfs:comment>Relative weight of the proficiency gap score in the combined gap score (0..1).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#AssessmentSnapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
