    <rdf:first rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb64"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
