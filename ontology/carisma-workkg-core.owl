    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ReviewStatus</rdfs:label>
    <rdfs:comment>Closed vocabulary for the review state of a requirement, assessment or mapping.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb1"/>
  </rdf:Description>
