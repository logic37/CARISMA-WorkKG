    <rdfs:label>UnresolvedCoverage</rdfs:label>
    <rdfs:comment>Inferred: a coverage result that cannot be determined from accepted, current evidence.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb63"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#Skill">
