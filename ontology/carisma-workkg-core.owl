    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://ict.ihu.gr/carisma-workkg#inSnapshot"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://ict.ihu.gr/carisma-workkg#AssessmentSnapshot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#assignedEmployee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assignedEmployee</rdfs:label>
    <rdfs:domain rdf:resource="https://ict.ihu.gr/carisma-workkg#RoleAssignment"/>
    <rdfs:range rdf:resource="https://ict.ihu.gr/carisma-workkg#Employee"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ML4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ict.ihu.gr/carisma-workkg#MaturityLevel"/>
    <rdfs:label>4 - Quantitatively Managed</rdfs:label>
    <cw:levelModel rdf:resource="https://ict.ihu.gr/carisma-workkg#CarismaMaturityRubric"/>
    <cw:ordinalRank rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</cw:ordinalRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#ProficiencyScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ProficiencyScale</rdfs:label>
    <rdfs:comment>A named and versioned proficiency rubric.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#priorityDetermined">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
