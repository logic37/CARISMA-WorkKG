    <rdfs:subClassOf rdf:nodeID="n71f690bc91b74bf3a83c2f976df1f99eb72"/>
    <rdfs:label>MaturityGap</rdfs:label>
    <rdfs:comment>A shortfall against a capability maturity target, traceable to the unmet criteria; not an employee score.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ict.ihu.gr/carisma-workkg#proficiencyGapScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
